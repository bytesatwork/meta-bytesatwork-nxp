From ef91f7e6a6befedff520334aec4dbf48f1093db5 Mon Sep 17 00:00:00 2001
From: Daniel Ammann <daniel.ammann@bytesatwork.ch>
Date: Fri, 5 Sep 2025 14:59:37 +0200
Subject: [PATCH] arm64: dts: freescale: imx93-byteengine: Remove PMIC IRQ
 configuration

The PMIC IRQ is not used.

Signed-off-by: Daniel Ammann <daniel.ammann@bytesatwork.ch>
---
 arch/arm64/boot/dts/freescale/imx93-byteengine.dtsi | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx93-byteengine.dtsi b/arch/arm64/boot/dts/freescale/imx93-byteengine.dtsi
index 666cef71cc..fdae740015 100644
--- a/arch/arm64/boot/dts/freescale/imx93-byteengine.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx93-byteengine.dtsi
@@ -35,8 +35,6 @@ &lpi2c2 {
 	pmic@25 {
 		compatible = "nxp,pca9451a";
 		reg = <0x25>;
-		interrupt-parent = <&gpio2>;
-		interrupts = <11 IRQ_TYPE_EDGE_FALLING>;
 
 		regulators {
 			buck1: BUCK1 {
