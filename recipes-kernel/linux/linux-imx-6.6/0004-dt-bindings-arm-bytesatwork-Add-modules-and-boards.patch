From 50c8819b788ec9e18534541a2a5dcd6c81352142 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Thu, 13 Jun 2024 12:59:34 +0200
Subject: [PATCH] dt-bindings: arm: bytesatwork: Add modules and boards

Add byteENGINEs and byteDEVKITs.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 .../bindings/arm/bytesatwork/bytesatwork.yaml | 41 +++++++++++++++++++
 MAINTAINERS                                   |  1 +
 2 files changed, 42 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml

diff --git a/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
new file mode 100644
index 0000000000..d9a7475ca2
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/bytesatwork/bytesatwork.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: bytesatwork Platforms Device Tree Bindings
+
+maintainers:
+  - Daniel Ammann <daniel.ammann@bytesatwork.ch>
+
+properties:
+  $nodename:
+    const: "/"
+  compatible:
+    oneOf:
+      - description: bytesatwork byteENGINE
+        items:
+          - enum:
+              - bytesatwork,byteengine-am62px
+              - bytesatwork,byteengine-am62x
+              - bytesatwork,byteengine-imx8mm
+              - bytesatwork,byteengine-imx8mp
+              - bytesatwork,byteengine-imx93
+              - bytesatwork,byteengine-stm32mp1
+              - bytesatwork,byteengine-stm32mp2
+
+      - description: bytesatwork byteDEVKIT
+        items:
+          - enum:
+              - bytesatwork,bytedevkit-am62px
+              - bytesatwork,bytedevkit-am62x
+              - bytesatwork,bytedevkit-imx8mm
+              - bytesatwork,bytedevkit-imx8mp
+              - bytesatwork,bytedevkit-imx93
+              - bytesatwork,bytedevkit-stm32mp1
+              - bytesatwork,bytedevkit-stm32mp2
+
+additionalProperties: true
+
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index cd6ad8cda5..4497beb0ca 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -4441,6 +4441,7 @@ BYTESATWORK MODULES AND BOARDS
 M:	Daniel Ammann <daniel.ammann@bytesatwork.ch>
 S:	Maintained
 F:	.github/workflows/checkpatch.yml
+F:	Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
 
 C-MEDIA CMI8788 DRIVER
 M:	Clemens Ladisch <clemens@ladisch.de>
