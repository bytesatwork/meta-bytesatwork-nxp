From 84b0c86136908dd377b3c2723672743efc86cc63 Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Wed, 25 Sep 2024 11:21:05 +0200
Subject: [PATCH] arch:arm64:dts: fix touch-lvds for byteDEVKIT3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Fix touch-lvds for byteDEVKIT3, dts.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Signed-off-by: Stephan Dünner <stephan.duenner@bytesatwork.ch>
---
 arch/arm64/boot/dts/freescale/imx8mp-bytedevkit.dts | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-bytedevkit.dts b/arch/arm64/boot/dts/freescale/imx8mp-bytedevkit.dts
index f0daf40efbd8..be9b2c84d730 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-bytedevkit.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-bytedevkit.dts
@@ -207,9 +207,9 @@ gt911@5d {
 		compatible = "goodix,gt911";
 		reg = <0x5d>;
 		interrupt-parent = <&gpio5>;
-		interrupts = <27 0>;
-		irq-gpios = <&gpio5 27 0>;
-		reset-gpios = <&gpio5 26 0>;
+		interrupts = <13 0>;
+		irq-gpios = <&gpio5 13 0>;
+		reset-gpios = <&gpio5 11 0>;
 		touchscreen-inverted-x;
 		touchscreen-inverted-y;
 	};
@@ -492,8 +492,8 @@ MX8MP_IOMUXC_GPIO1_IO15__USB2_OC	0x10
 
 	pinctrl_touch: touch_grp {
 		fsl,pins = <
-			MX8MP_IOMUXC_UART3_RXD__GPIO5_IO26	0x10	/* Touch Reset*/
-			MX8MP_IOMUXC_UART3_TXD__GPIO5_IO27	0x10	/* Touch Int */
+			MX8MP_IOMUXC_ECSPI2_MOSI__GPIO5_IO11	0x10	/* Touch Reset*/
+			MX8MP_IOMUXC_ECSPI2_SS0__GPIO5_IO13	0x10	/* Touch Int */
 		>;
 	};
 
