From 3dd96b1bbaaf55bd8555f0741466618e4fdefb8d Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Tue, 30 Sep 2025 10:48:10 +0200
Subject: [PATCH] configs: Add quiet to kernel bootargs for bytedevkit boards

Reduces output during boot to speed up total boot time.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 include/configs/imx8mm_bytedevkit.h | 2 +-
 include/configs/imx8mp_bytedevkit.h | 3 ++-
 include/configs/imx93_bytedevkit.h  | 3 ++-
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/include/configs/imx8mm_bytedevkit.h b/include/configs/imx8mm_bytedevkit.h
index 5c84b82456..49e306f317 100644
--- a/include/configs/imx8mm_bytedevkit.h
+++ b/include/configs/imx8mm_bytedevkit.h
@@ -36,7 +36,7 @@
 	"initrd_addr=0x43800000\0" \
 	"mmcroot=/dev/mmcblk1p1 rootwait rw\0" \
 	"emmcroot=/dev/mmcblk0p1 rootwait rw\0" \
-	"bootargs=setenv bootargs console=${console} root=${fsroot} " \
+	"bootargs=setenv bootargs console=${console} root=${fsroot} quiet " \
 		"${kernelargs} ${bootargs_append}\0" \
 	"mmcargs=setenv mmcdev 1; setenv fsroot ${mmcroot}; run bootargs;\0" \
 	"emmcargs=setenv mmcdev 2; setenv fsroot ${emmcroot}; run bootargs;\0" \
diff --git a/include/configs/imx8mp_bytedevkit.h b/include/configs/imx8mp_bytedevkit.h
index 4b96c8a672..c3637c60d5 100644
--- a/include/configs/imx8mp_bytedevkit.h
+++ b/include/configs/imx8mp_bytedevkit.h
@@ -65,7 +65,8 @@
 	"mmcpart=1\0" \
 	"mmcroot=/dev/mmcblk1p1 rootwait rw\0" \
 	"mmcautodetect=yes\0" \
-	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}\0 " \
+	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot} " \
+		"quiet\0" \
 	"loadbootscript=ext4load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bsp_script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
diff --git a/include/configs/imx93_bytedevkit.h b/include/configs/imx93_bytedevkit.h
index 824e6d0b53..371f70eb8e 100644
--- a/include/configs/imx93_bytedevkit.h
+++ b/include/configs/imx93_bytedevkit.h
@@ -66,7 +66,8 @@
 	"mmcpart=1\0" \
 	"mmcroot=/dev/mmcblk1p1 rootwait rw\0" \
 	"mmcautodetect=yes\0" \
-	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}\0 " \
+	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot} " \
+		"quiet\0" \
 	"loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
