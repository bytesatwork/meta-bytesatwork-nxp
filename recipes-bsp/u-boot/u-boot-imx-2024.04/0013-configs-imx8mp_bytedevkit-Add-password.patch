From 504095f1f6d7c73bd1e945595bce538ad4399ca2 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Mon, 29 Sep 2025 12:43:13 +0200
Subject: [PATCH] configs: imx8mp_bytedevkit: Add password

Enables autoboot stop password and sets boot delay to 1 second.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 configs/imx8mp_bytedevkit_defconfig | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/configs/imx8mp_bytedevkit_defconfig b/configs/imx8mp_bytedevkit_defconfig
index 54346f4693..e51a11f8ae 100644
--- a/configs/imx8mp_bytedevkit_defconfig
+++ b/configs/imx8mp_bytedevkit_defconfig
@@ -36,6 +36,11 @@ CONFIG_SPL_LOAD_FIT=y
 CONFIG_LEGACY_IMAGE_FORMAT=y
 CONFIG_SYS_BOOTM_LEN=0x2000000
 CONFIG_DISTRO_DEFAULTS=y
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_OF_BOARD_SETUP=y
 CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_BOOTCOMMAND="run bsp_bootcmd"
