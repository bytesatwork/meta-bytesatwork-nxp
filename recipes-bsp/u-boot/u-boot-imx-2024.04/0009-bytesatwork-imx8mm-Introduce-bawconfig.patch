+++ b/board/bytesatwork/bytedevkit_imx8mm/Makefile
@@ -14,3 +14,5 @@ obj-y += spl.o
 obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_512_1024_1536_2048.o
 obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_3072_4096.o
