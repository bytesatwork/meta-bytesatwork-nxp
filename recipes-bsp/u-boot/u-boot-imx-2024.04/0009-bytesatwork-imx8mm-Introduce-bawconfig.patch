From 92d173c1aef5078472a68abaa4e73046cf9e4483 Mon Sep 17 00:00:00 2001
From: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Date: Tue, 1 Mar 2022 14:29:16 +0100
Subject: [PATCH] bytesatwork: imx8mm: Introduce bawconfig

Enable bytesatwork tool to store production data in EEPROM.

Signed-off-by: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 board/bytesatwork/bytedevkit_imx8mm/Kconfig   |  2 +
 board/bytesatwork/bytedevkit_imx8mm/Makefile  |  2 +
 .../bytedevkit_imx8mm/imx8mm_bytedevkit.c     | 74 +++++++++++++++++++
 board/bytesatwork/bytedevkit_imx8mm/spl.c     | 56 +++++++++++++-
 configs/imx8mm_bytedevkit_defconfig           | 10 ++-
 configs/imx8mm_bytedevkit_fspi_defconfig      | 14 ++--
 include/configs/imx8mm_bytedevkit.h           | 11 +--
 7 files changed, 154 insertions(+), 15 deletions(-)

diff --git a/board/bytesatwork/bytedevkit_imx8mm/Kconfig b/board/bytesatwork/bytedevkit_imx8mm/Kconfig
index c97eb8fcca..3468f35d4f 100644
--- a/board/bytesatwork/bytedevkit_imx8mm/Kconfig
+++ b/board/bytesatwork/bytedevkit_imx8mm/Kconfig
@@ -17,4 +17,6 @@ config IMX_CONFIG
 	default "board/bytesatwork/bytedevkit_imx8mm/imximage-8mm-lpddr4-fspi.cfg" if IMX8MM_BYTEDEVKIT_FSPI_BOOT
 	default "arch/arm/mach-imx/imx8m/imximage.cfg"
 
+source "board/bytesatwork/baw_config/Kconfig"
+
 endif
