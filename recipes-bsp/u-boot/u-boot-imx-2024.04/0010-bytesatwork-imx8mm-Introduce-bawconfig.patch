--- a/configs/imx8mm_bytedevkit_fspi_defconfig
+++ b/configs/imx8mm_bytedevkit_fspi_defconfig
@@ -19,6 +19,8 @@ CONFIG_SPL_TEXT_BASE=0x7E2000
 CONFIG_USB_TCPC=y
 CONFIG_TARGET_IMX8MM_BYTEDEVKIT=y
 CONFIG_IMX8MM_BYTEDEVKIT_FSPI_BOOT=y
+CONFIG_BAW_CONFIG_EEPROM_BUS=1
+CONFIG_BAW_CONFIG_EEPROM_BUS_NAME="i2c@30a30000"
 CONFIG_SYS_MONITOR_LEN=524288
 CONFIG_SPL_MMC=y
 CONFIG_SPL_SERIAL=y
diff --git a/include/configs/imx8mm_bytedevkit.h b/include/configs/imx8mm_bytedevkit.h
index 3775906ca3..49e306f317 100644
--- a/include/configs/imx8mm_bytedevkit.h
+++ b/include/configs/imx8mm_bytedevkit.h
@@ -13,6 +13,11 @@
 #include <asm/arch/imx-regs.h>
 #include "imx_env.h"
 
+#define BAW_CONFIG_BUILTIN_PCB		M6_PCB_REV_1_0
+#define BAW_CONFIG_BUILTIN_RAM		M6_RAM_MT53E128M32D2DS_053
+#define BAW_CONFIG_BUILTIN_FLASH	EMMC_16GB
+#define BAW_CONFIG_RAM_SIZE_PTR_ADDR	0x0091ffe0
+
 #define CFG_SYS_UBOOT_BASE	\
 	(QSPI0_AMBA_BASE + CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR * 512)
 
