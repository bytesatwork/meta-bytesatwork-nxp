From 4ecc9e73193c73e176873f7857338421595ed1a3 Mon Sep 17 00:00:00 2001
From: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Date: Tue, 1 Mar 2022 14:29:16 +0100
Subject: [PATCH] bytesatwork: imx8mm: Introduce bawconfig

Enable bytesatwork tool to store production data in EEPROM.

Signed-off-by: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 board/bytesatwork/bytedevkit_imx8mm/Kconfig   |  2 +
 board/bytesatwork/bytedevkit_imx8mm/Makefile  |  2 +
 .../bytedevkit_imx8mm/imx8mm_bytedevkit.c     | 55 ++++++++++++++++++
 board/bytesatwork/bytedevkit_imx8mm/spl.c     | 56 ++++++++++++++++++-
 configs/imx8mm_bytedevkit_defconfig           |  2 +
 configs/imx8mm_bytedevkit_fspi_defconfig      |  2 +
 include/configs/imx8mm_bytedevkit.h           |  5 ++
 7 files changed, 122 insertions(+), 2 deletions(-)

diff --git a/board/bytesatwork/bytedevkit_imx8mm/Kconfig b/board/bytesatwork/bytedevkit_imx8mm/Kconfig
index c97eb8fcca..3468f35d4f 100644
--- a/board/bytesatwork/bytedevkit_imx8mm/Kconfig
+++ b/board/bytesatwork/bytedevkit_imx8mm/Kconfig
@@ -17,4 +17,6 @@ config IMX_CONFIG
 	default "board/bytesatwork/bytedevkit_imx8mm/imximage-8mm-lpddr4-fspi.cfg" if IMX8MM_BYTEDEVKIT_FSPI_BOOT
 	default "arch/arm/mach-imx/imx8m/imximage.cfg"
 
+source "board/bytesatwork/baw_config/Kconfig"
+
 endif
diff --git a/board/bytesatwork/bytedevkit_imx8mm/Makefile b/board/bytesatwork/bytedevkit_imx8mm/Makefile
index 8ff7e44165..f5cfb2bac6 100644
--- a/board/bytesatwork/bytedevkit_imx8mm/Makefile
+++ b/board/bytesatwork/bytedevkit_imx8mm/Makefile
@@ -14,3 +14,5 @@ obj-y += spl.o
 obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_512_1024_1536_2048.o
 obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_3072_4096.o
 endif
+
+obj-y += ../baw_config/
diff --git a/board/bytesatwork/bytedevkit_imx8mm/imx8mm_bytedevkit.c b/board/bytesatwork/bytedevkit_imx8mm/imx8mm_bytedevkit.c
index 47d50fe7cd..9eee26068f 100644
--- a/board/bytesatwork/bytedevkit_imx8mm/imx8mm_bytedevkit.c
+++ b/board/bytesatwork/bytedevkit_imx8mm/imx8mm_bytedevkit.c
@@ -29,6 +29,7 @@
 #include <asm/mach-imx/video.h>
 #include <power/pca9450.h>
 #include <linux/delay.h>
+#include "../baw_config/baw_config_eeprom.h"
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -84,6 +85,11 @@ int board_early_init_f(void)
 
 	init_uart_clk(1);
 
+#ifdef CONFIG_SPL_BUILD
+	/* SPL does not use DM compared to u-boot, so setup manually */
+	setup_i2c(CONFIG_BAW_CONFIG_EEPROM_BUS, SPL_I2C_SPEED,
+		  CONFIG_BAW_CONFIG_EEPROM_ADDRESS, &i2c2_pad_info);
+#endif
 	return 0;
 }
 
@@ -192,6 +198,11 @@ int board_late_init(void)
 	board_late_mmc_env_init();
 #endif
 
+#ifdef CONFIG_BAW_CONFIG_EEPROM
+	if (baw_config_eeprom_init())
+		printf("EEPROM init failed!\n");
+#endif
+
 	return 0;
 }
 
@@ -203,3 +214,47 @@ int board_mmc_get_env_dev(int devno)
 	return devno;
 #endif
 }
+
+#include <asm/armv8/mmu.h>
+extern struct mm_region *mem_map;
+
+/* based on arch/arm/mach-imx/imx8m/soc.c */
+static u8 imx8m_find_dram_entry_in_mem_map(u64 phys_addr)
+{
+	u8 i;
+
+	for (i = 0; mem_map[i].size != 0; i++)
+		if (mem_map[i].phys == phys_addr)
+			return i;
+
+	hang(); /* Entry not found, this must never happen. */
+}
+
+int board_phys_sdram_size(phys_size_t *size)
+{
+	u8 index;
+	/* NOTE: value passed from SPL (same address as set in SPL) */
+	phys_size_t *ram_size = (phys_size_t *)BAW_CONFIG_RAM_SIZE_PTR_ADDR;
+
+	index = imx8m_find_dram_entry_in_mem_map(CFG_SYS_SDRAM_BASE);
+
+	if (!size)
+		return -EINVAL;
+
+	switch (*ram_size) {
+	case SZ_512M:
+	case SZ_1G:
+	case (SZ_1G + SZ_512M):
+	case SZ_2G:
+	case (SZ_2G + SZ_1G):
+		mem_map[index].size = *ram_size;
+		*size = *ram_size;
+		break;
+	case SZ_4G:
+		return -EOPNOTSUPP;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
diff --git a/board/bytesatwork/bytedevkit_imx8mm/spl.c b/board/bytesatwork/bytedevkit_imx8mm/spl.c
index 4bd2b33706..b494a5d2d2 100644
--- a/board/bytesatwork/bytedevkit_imx8mm/spl.c
+++ b/board/bytesatwork/bytedevkit_imx8mm/spl.c
@@ -29,6 +29,8 @@
 #include <linux/delay.h>
 
 #include "lpddr4_timings.h"
+#include "../baw_config/baw_config_eeprom.h"
+#include "../baw_config/baw_config_get.h"
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -52,10 +54,60 @@ int spl_board_boot_device(enum boot_device boot_dev_spl)
 	}
 }
 
+/* NOTE: ddr timing config params, see arch/arm/include/asm/arch-imx8m/ddr.h */
+struct dram_timing_info dram_timing;
+
+struct dram_setup {
+	enum baw_config_ram ram;
+	const phys_size_t size;
+	const struct dram_timing_info *timing;
+};
+
 void spl_dram_init(void)
 {
-	/* Use 512MB RAM as default */
-	ddr_init(&dram_timing_512);
+	/* NOTE: store ram_size in OCRAM to pass value from SPL to u-boot */
+	phys_size_t *ram_size = (phys_size_t *)BAW_CONFIG_RAM_SIZE_PTR_ADDR;
+	const struct dram_setup dram_setups[] = {
+		{ M6_RAM_MT53E128M32D2DS_053, SZ_512M, &dram_timing_512 },
+		{ M6_RAM_MT53E256M32D2DS_053, SZ_1G, &dram_timing_1024 },
+		{ M6_RAM_MT53E384M32D2DS_053, SZ_1G + SZ_512M,
+		  &dram_timing_1536 },
+		{ M6_RAM_MT53D512M32D2DS_053, SZ_2G, &dram_timing_2048 },
+		{ M6_RAM_MT53E768M32D4DT_053, SZ_2G + SZ_1G,
+		  &dram_timing_3072 },
+		{ M6_RAM_MT53D1024M32D4DT_053_3GB, SZ_2G + SZ_1G,
+		  &dram_timing_3072 },
+		/* fallbacks */
+		{ M6_RAM_MT53D1024M32D4DT_053, SZ_512M, &dram_timing_3072 },
+		{ 0, 0, NULL },
+	};
+	struct baw_config config;
+	bool ram_found = false;
+	int i;
+
+#ifdef CONFIG_BAW_CONFIG_EEPROM
+	if (baw_config_eeprom_init())
+		printf("EEPROM init failed!\n");
+#endif
+
+	baw_config_get(&config);
+	for (i = 0; dram_setups[i].ram > 0; i++) {
+		if (config.ram == dram_setups[i].ram) {
+			memcpy(&dram_timing, dram_setups[i].timing,
+			       sizeof(dram_timing));
+			*ram_size = dram_setups[i].size;
+			ram_found = true;
+			break;
+		}
+	}
+
+	if (!ram_found) {
+		printf("Error: Unknown RAM config, use fallback.\n");
+		memcpy(&dram_timing, &dram_timing_512, sizeof(dram_timing));
+		*ram_size = dram_setups[0].size;
+	}
+
+	ddr_init(&dram_timing);
 }
 
 #define USDHC2_CD_GPIO	IMX_GPIO_NR(2, 12)
