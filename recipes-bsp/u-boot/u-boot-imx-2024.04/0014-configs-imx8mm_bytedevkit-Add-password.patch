From 78ebc5c91a6c8b73c4b08247e3a457a2a302dd21 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Mon, 29 Sep 2025 12:58:44 +0200
Subject: [PATCH] configs: imx8mm_bytedevkit: Add password

Enables autoboot stop password and sets boot delay to 1 second.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 configs/imx8mm_bytedevkit_defconfig      | 5 +++++
 configs/imx8mm_bytedevkit_fspi_defconfig | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/configs/imx8mm_bytedevkit_defconfig b/configs/imx8mm_bytedevkit_defconfig
index 44208700fb..512f479ef1 100644
--- a/configs/imx8mm_bytedevkit_defconfig
+++ b/configs/imx8mm_bytedevkit_defconfig
@@ -35,6 +35,11 @@ CONFIG_FIT=y
 CONFIG_FIT_EXTERNAL_OFFSET=0x3000
 CONFIG_SPL_LOAD_FIT=y
 CONFIG_SYS_BOOTM_LEN=0x02000000
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_BOOTCOMMAND="run bsp_bootcmd"
diff --git a/configs/imx8mm_bytedevkit_fspi_defconfig b/configs/imx8mm_bytedevkit_fspi_defconfig
index f1b939efa8..c7acd5f05a 100644
--- a/configs/imx8mm_bytedevkit_fspi_defconfig
+++ b/configs/imx8mm_bytedevkit_fspi_defconfig
@@ -36,6 +36,11 @@ CONFIG_FIT=y
 CONFIG_FIT_EXTERNAL_OFFSET=0x3000
 CONFIG_SPL_LOAD_FIT=y
 CONFIG_SYS_BOOTM_LEN=0x02000000
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_BOOTCOMMAND="run bsp_bootcmd"
