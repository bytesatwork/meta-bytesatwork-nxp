From 3ff8a709a641d9865640aa0d31772effb766bb5c Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Mon, 29 Sep 2025 15:13:54 +0200
Subject: [PATCH] configs: imx93_bytedevkit: Add password

Enables autoboot stop password and sets boot delay to 1 second.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 configs/imx93_bytedevkit_defconfig | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/configs/imx93_bytedevkit_defconfig b/configs/imx93_bytedevkit_defconfig
index 46dc70620b..d793cc6299 100644
--- a/configs/imx93_bytedevkit_defconfig
+++ b/configs/imx93_bytedevkit_defconfig
@@ -34,6 +34,11 @@ CONFIG_FIT=y
 CONFIG_FIT_SIGNATURE=y
 CONFIG_LEGACY_IMAGE_FORMAT=y
 CONFIG_DISTRO_DEFAULTS=y
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_BOOTCOMMAND="run sr_ir_v2_cmd;run distro_bootcmd;run bsp_bootcmd"
 CONFIG_DEFAULT_FDT_FILE="imx93-bytedevkit.dtb"
