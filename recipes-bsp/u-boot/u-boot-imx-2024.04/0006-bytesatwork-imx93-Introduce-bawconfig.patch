From d8c24392316d67d0d28b91ab6b71332ae0d3c38d Mon Sep 17 00:00:00 2001
From: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Date: Thu, 20 Jun 2024 14:05:21 +0200
Subject: [PATCH] bytesatwork: imx93: Introduce bawconfig

Enable bytesatwork tool to store production data in EEPROM.

Signed-off-by: Rico Ganahl <rico.ganahl@bytesatwork.ch>
---
 board/bytesatwork/bytedevkit_imx93/Kconfig            | 2 ++
 board/bytesatwork/bytedevkit_imx93/Makefile           | 2 ++
 board/bytesatwork/bytedevkit_imx93/imx93_bytedevkit.c | 7 +++++++
 board/bytesatwork/bytedevkit_imx93/spl.c              | 6 ++++++
 configs/imx93_bytedevkit_defconfig                    | 4 ++++
 include/configs/imx93_bytedevkit.h                    | 4 ++++
 6 files changed, 25 insertions(+)

diff --git a/board/bytesatwork/bytedevkit_imx93/Kconfig b/board/bytesatwork/bytedevkit_imx93/Kconfig
index efc2d6dee3..e88f015c0b 100644
--- a/board/bytesatwork/bytedevkit_imx93/Kconfig
+++ b/board/bytesatwork/bytedevkit_imx93/Kconfig
@@ -31,4 +31,6 @@ config IMX93_BYTEDEVKIT_LPDDR4
 
 endchoice
 
+source "board/bytesatwork/baw_config/Kconfig"
+
 endif
diff --git a/board/bytesatwork/bytedevkit_imx93/Makefile b/board/bytesatwork/bytedevkit_imx93/Makefile
index 4509fb04e6..ebc6c31bd0 100644
--- a/board/bytesatwork/bytedevkit_imx93/Makefile
+++ b/board/bytesatwork/bytedevkit_imx93/Makefile
@@ -14,3 +14,5 @@ obj-y += spl.o
 obj-$(CONFIG_IMX93_BYTEDEVKIT_LPDDR4X) += lpddr4x_timing.o lpddr4x_timing_1866mts.o
 obj-$(CONFIG_IMX93_BYTEDEVKIT_LPDDR4) += lpddr4_timing_2400mts.o
 endif
+
+obj-y += ../baw_config/
diff --git a/board/bytesatwork/bytedevkit_imx93/imx93_bytedevkit.c b/board/bytesatwork/bytedevkit_imx93/imx93_bytedevkit.c
index 6c28afe383..9a1cbd5c46 100644
--- a/board/bytesatwork/bytedevkit_imx93/imx93_bytedevkit.c
+++ b/board/bytesatwork/bytedevkit_imx93/imx93_bytedevkit.c
@@ -22,6 +22,7 @@
 #include <usb.h>
 #include <dwc3-uboot.h>
 #include <asm/gpio.h>
+#include "../baw_config/baw_config_eeprom.h"
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -108,6 +109,12 @@ int board_late_init(void)
 	env_set("board_name", "byteDEVKIT");
 	env_set("board_rev", "iMX93");
 #endif
+
+	if (IS_ENABLED(CONFIG_BAW_CONFIG_EEPROM)) {
+		if (baw_config_eeprom_init())
+			printf("EEPROM init failed!\n");
+	}
+
 	return 0;
 }
 
diff --git a/board/bytesatwork/bytedevkit_imx93/spl.c b/board/bytesatwork/bytedevkit_imx93/spl.c
index 80ef11164e..f810f50ad4 100644
--- a/board/bytesatwork/bytedevkit_imx93/spl.c
+++ b/board/bytesatwork/bytedevkit_imx93/spl.c
@@ -36,6 +36,7 @@
 #include <power/pmic.h>
 #include <power/pca9450.h>
 #include <asm/arch/trdc.h>
+#include "../baw_config/baw_config_eeprom.h"
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -73,6 +74,11 @@ void spl_dram_init(void)
 {
 	struct dram_timing_info *ptiming = &dram_timing;
 
+	if (IS_ENABLED(CONFIG_BAW_CONFIG_EEPROM)) {
+		if (baw_config_eeprom_init())
+			printf("EEPROM init failed!\n");
+	}
+
 #if IS_ENABLED(CONFIG_IMX93_BYTEDEVKIT_LPDDR4X)
 	if (is_voltage_mode(VOLT_LOW_DRIVE))
 		ptiming = &dram_timing_1866mts;
diff --git a/configs/imx93_bytedevkit_defconfig b/configs/imx93_bytedevkit_defconfig
index 1e4c7bee03..46dc70620b 100644
--- a/configs/imx93_bytedevkit_defconfig
+++ b/configs/imx93_bytedevkit_defconfig
@@ -13,6 +13,10 @@ CONFIG_DM_GPIO=y
 CONFIG_DEFAULT_DEVICE_TREE="imx93-bytedevkit"
 CONFIG_SPL_TEXT_BASE=0x2049A000
 CONFIG_TARGET_IMX93_BYTEDEVKIT=y
+CONFIG_BAW_CONFIG_EEPROM_BUS_NAME="i2c@44350000"
+CONFIG_BAW_CONFIG_EEPROM_ADDRESS_BYTES=1
+CONFIG_BAW_CONFIG_EEPROM_MAX_WRITE=16
+CONFIG_BAW_CONFIG_EEPROM_WRITE_DELAY_MS=5
 CONFIG_OF_LIBFDT_OVERLAY=y
 CONFIG_SYS_MONITOR_LEN=524288
 CONFIG_SPL_SERIAL=y
diff --git a/include/configs/imx93_bytedevkit.h b/include/configs/imx93_bytedevkit.h
index c6242066cc..371f70eb8e 100644
--- a/include/configs/imx93_bytedevkit.h
+++ b/include/configs/imx93_bytedevkit.h
@@ -14,6 +14,10 @@
 #include <asm/arch/imx-regs.h>
 #include "imx_env.h"
 
+#define BAW_CONFIG_BUILTIN_PCB		M9_PCB_REV_1_0
+#define BAW_CONFIG_BUILTIN_RAM		M9_RAM_MT53D512M16D1DS_046
+#define BAW_CONFIG_BUILTIN_FLASH	EMMC_16GB
+
 #define CFG_SYS_UBOOT_BASE	\
 	(QSPI0_AMBA_BASE + CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR * 512)
 
