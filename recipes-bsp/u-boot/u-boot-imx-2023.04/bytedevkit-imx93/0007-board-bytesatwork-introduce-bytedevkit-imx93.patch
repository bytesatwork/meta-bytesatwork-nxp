From 851d0044a45775fafc20837b2048e45d7ed2bb41 Mon Sep 17 00:00:00 2001
From: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Date: Thu, 30 May 2024 13:56:19 +0200
Subject: [PATCH] board: bytesatwork: introduce bytedevkit imx93
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Changes from imx93_evk to byteDEVKIT IMX93 from bytesatwork.

Signed-off-by: Stephan Dünner <stephan.duenner@bytesatwork.ch>
Signed-off-by: Rico Ganahl <rico.ganahl@bytesatwork.ch>
---
 board/bytesatwork/bytedevkit_imx93/Kconfig    |  17 +-
 board/bytesatwork/bytedevkit_imx93/Makefile   |  14 +-
 .../bytedevkit_imx93/imx93_bytedevkit.c       | 259 +--------
 .../bytedevkit_imx93/lpddr4x_timing.c         | 545 ++----------------
 board/bytesatwork/bytedevkit_imx93/spl.c      |  85 +--
 5 files changed, 73 insertions(+), 847 deletions(-)

diff --git a/board/bytesatwork/bytedevkit_imx93/Kconfig b/board/bytesatwork/bytedevkit_imx93/Kconfig
index 6f9f896dd5..0b788e3eca 100644
--- a/board/bytesatwork/bytedevkit_imx93/Kconfig
+++ b/board/bytesatwork/bytedevkit_imx93/Kconfig
@@ -1,27 +1,28 @@
-if TARGET_IMX93_11X11_EVK || TARGET_IMX93_14X14_EVK || TARGET_IMX91P_11X11_EVK
+# Copyright (C) 2024 bytesatwork AG - https://www.bytesatwork.io
+
+if TARGET_IMX93_BYTEDEVKIT
 
 config SYS_BOARD
-	default "imx93_evk"
+	default "bytedevkit_imx93"
 
 config SYS_VENDOR
-	default "freescale"
+	default "bytesatwork"
 
 config SYS_CONFIG_NAME
-	default "imx93_evk"
+	default "imx93_bytedevkit"
 
 choice
 	prompt "Select DDR Type"
-	default IMX93_EVK_LPDDR4X if TARGET_IMX93_11X11_EVK || TARGET_IMX93_14X14_EVK
-	default IMX93_EVK_LPDDR4 if TARGET_IMX91P_11X11_EVK
+	default IMX93_BYTEDEVKIT_LPDDR4X
 
-config IMX93_EVK_LPDDR4X
+config IMX93_BYTEDEVKIT_LPDDR4X
 	bool "Using LPDDR4X Timing and PMIC voltage"
 	select IMX9_LPDDR4X
 	help
 	  Select the LPDDR4X timing
 	  and 0.6V VDDQ
 
-config IMX93_EVK_LPDDR4
+config IMX93_BYTEDEVKIT_LPDDR4
 	bool "Using LPDDR4 Timing and PMIC voltage"
 	select IMX9_LPDDR4X
 	help
diff --git a/board/bytesatwork/bytedevkit_imx93/Makefile b/board/bytesatwork/bytedevkit_imx93/Makefile
index b6b978ddbe..cf97a3fcc3 100644
--- a/board/bytesatwork/bytedevkit_imx93/Makefile
+++ b/board/bytesatwork/bytedevkit_imx93/Makefile
@@ -1,18 +1,16 @@
