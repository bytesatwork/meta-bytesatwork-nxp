From 6c24ff3e726d2d8356ca9b015a84531d38a040a4 Mon Sep 17 00:00:00 2001
From: Rico Ganahl <rico.ganahl@bytesatwork.ch>
Date: Thu, 23 May 2024 12:59:07 +0200
Subject: [PATCH] arm: mach-imx: introduce bytedevkit imx93

Create custom target for bytesatwork byteDEVKIT IMX93.

Signed-off-by: Rico Ganahl <rico.ganahl@bytesatwork.ch>
---
 arch/arm/mach-imx/imx9/Kconfig | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm/mach-imx/imx9/Kconfig b/arch/arm/mach-imx/imx9/Kconfig
index 2e306fa5ad..cd81dbd9be 100644
--- a/arch/arm/mach-imx/imx9/Kconfig
+++ b/arch/arm/mach-imx/imx9/Kconfig
@@ -43,6 +43,11 @@ config TARGET_IMX93_9X9_QSB
 	select IMX93
 	select IMX9_LPDDR4X
 
+config TARGET_IMX93_BYTEDEVKIT
+	bool "bytesatwork byteDEVKIT imx93 board"
+	select OF_BOARD_FIXUP
+	select IMX93
+
 config TARGET_IMX91P_11X11_EVK
 	bool "imx91p_11x11_evk"
 	select IMX93
@@ -62,6 +67,7 @@ config TARGET_TITAN_IMX95_19X19
 
 endchoice
 
+source "board/bytesatwork/bytedevkit_imx93/Kconfig"
 source "board/freescale/imx93_evk/Kconfig"
 source "board/freescale/imx93_qsb/Kconfig"
 source "board/freescale/imx95_evk/Kconfig"
