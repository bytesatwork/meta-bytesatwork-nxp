From 053ebb9ba8289fb43d96bdb2215bc758109b8bee Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Wed, 27 Mar 2024 08:35:56 +0100
Subject: [PATCH] board, dts, configs: removed unused parts

Adaptations for imx8mp bytedevkit.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 arch/arm/dts/imx8mp-bytedevkit.dts            | 87 -------------------
 board/bytesatwork/bytedevkit_imx8mp/Kconfig   |  2 -
 .../bytedevkit_imx8mp/imx8mp_bytedevkit.c     |  7 +-
 board/bytesatwork/bytedevkit_imx8mp/spl.c     |  1 -
 board/bytesatwork/common                      |  1 -
 configs/imx8mp_bytedevkit_defconfig           |  3 +-
 include/configs/imx8mp_bytedevkit.h           | 14 +--
 7 files changed, 4 insertions(+), 111 deletions(-)
 delete mode 120000 board/bytesatwork/common

diff --git a/arch/arm/dts/imx8mp-bytedevkit.dts b/arch/arm/dts/imx8mp-bytedevkit.dts
index fabfdb2405..4bd99ade8f 100644
--- a/arch/arm/dts/imx8mp-bytedevkit.dts
+++ b/arch/arm/dts/imx8mp-bytedevkit.dts
@@ -73,31 +73,6 @@
 		off-on-delay-us = <12000>;
 	};
 
-	dsi_host: dsi-host {
-		compatible = "samsung,sec-mipi-dsi";
-		status = "okay";
-	};
-
-	rm67199_panel {
-		compatible = "raydium,rm67199";
-		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_mipi_dsi_en>;
-		reset-gpio = <&gpio1 8 GPIO_ACTIVE_LOW>;
-		dsi-lanes = <4>;
-		video-mode = <2>;	/* 0: burst mode
-					 * 1: non-burst mode with sync event
-					 * 2: non-burst mode with sync pulse
-					 */
-		panel-width-mm = <68>;
-		panel-height-mm = <121>;
-		status = "okay";
-
-		port {
-			rm67191_from_dsim: endpoint {
-				remote-endpoint = <&dsim_to_rm67191>;
-			};
-		};
-	};
 };
 
 &flexcan1 {
@@ -287,68 +262,6 @@
 	};
 };
 
-&i2c2 {
-	clock-frequency = <400000>;
-	pinctrl-names = "default", "gpio";
-	pinctrl-0 = <&pinctrl_i2c2>;
-	pinctrl-1 = <&pinctrl_i2c2_gpio>;
-	scl-gpios = <&gpio5 16 GPIO_ACTIVE_HIGH>;
-	sda-gpios = <&gpio5 17 GPIO_ACTIVE_HIGH>;
-	status = "okay";
-
-	adv_bridge: adv7535@3d {
-		compatible = "adi,adv7535";
-		reg = <0x3d>;
-		adi,addr-cec = <0x3c>;
-		adi,dsi-lanes = <4>;
-		status = "okay";
-
-		port {
-			adv7535_from_dsim: endpoint {
-				remote-endpoint = <&dsim_to_adv7535>;
-			};
-		};
-	};
-
-};
-
-&i2c3 {
-	clock-frequency = <100000>;
-	pinctrl-names = "default", "gpio";
-	pinctrl-0 = <&pinctrl_i2c3>;
-	pinctrl-1 = <&pinctrl_i2c3_gpio>;
-	scl-gpios = <&gpio5 18 GPIO_ACTIVE_HIGH>;
-	sda-gpios = <&gpio5 19 GPIO_ACTIVE_HIGH>;
-	status = "okay";
-
-	pca6416: gpio@20 {
-		compatible = "ti,tca6416";
-		reg = <0x20>;
-		gpio-controller;
-		#gpio-cells = <2>;
-	};
-};
-
-&lcdif1 {
-	status = "okay";
-};
-
-&mipi_dsi {
-	status = "okay";
-
-	port@1 {
-		dsim_to_adv7535: endpoint {
-			remote-endpoint = <&adv7535_from_dsim>;
-		};
-	};
-
-	port@2 {
-		dsim_to_rm67191: endpoint {
-			remote-endpoint = <&rm67191_from_dsim>;
-		};
-	};
-};
-
 &snvs_pwrkey {
 	status = "okay";
 };
diff --git a/board/bytesatwork/bytedevkit_imx8mp/Kconfig b/board/bytesatwork/bytedevkit_imx8mp/Kconfig
index 7362dba889..cff47a7922 100644
--- a/board/bytesatwork/bytedevkit_imx8mp/Kconfig
+++ b/board/bytesatwork/bytedevkit_imx8mp/Kconfig
@@ -12,6 +12,4 @@ config SYS_CONFIG_NAME
 config IMX_CONFIG
 	default "board/bytesatwork/bytedevkit_imx8mp/imximage-8mp-lpddr4.cfg"
 
-source "board/bytesatwork/common/Kconfig"
-
 endif
diff --git a/board/bytesatwork/bytedevkit_imx8mp/imx8mp_bytedevkit.c b/board/bytesatwork/bytedevkit_imx8mp/imx8mp_bytedevkit.c
index c9678c50dd..8563255547 100644
--- a/board/bytesatwork/bytedevkit_imx8mp/imx8mp_bytedevkit.c
+++ b/board/bytesatwork/bytedevkit_imx8mp/imx8mp_bytedevkit.c
@@ -7,7 +7,6 @@
  *
  */
 
-#include <common.h>
 #include <efi_loader.h>
 #include <env.h>
 #include <errno.h>
@@ -27,7 +26,6 @@
 #include <spl.h>
 #include <asm/mach-imx/dma.h>
 #include <power/pmic.h>
-#include "../common/tcpc.h"
 #include <usb.h>
 #include <dwc3-uboot.h>
 #include <imx_sip.h>
@@ -494,11 +492,8 @@ int board_init(void)
 
 int board_late_init(void)
 {
-#ifdef CONFIG_ENV_IS_IN_MMC
-	board_late_mmc_env_init();
-#endif
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
-	env_set("board_name", "EVK");
+	env_set("board_name", "BYTEDEVKIT");
 	env_set("board_rev", "iMX8MP");
 #endif
 
diff --git a/board/bytesatwork/bytedevkit_imx8mp/spl.c b/board/bytesatwork/bytedevkit_imx8mp/spl.c
index b8f2149415..750631c3f8 100644
--- a/board/bytesatwork/bytedevkit_imx8mp/spl.c
+++ b/board/bytesatwork/bytedevkit_imx8mp/spl.c
@@ -7,7 +7,6 @@
  *
  */
 
-#include <common.h>
 #include <hang.h>
 #include <init.h>
 #include <log.h>
diff --git a/board/bytesatwork/common b/board/bytesatwork/common
deleted file mode 120000
index 7506078986..0000000000
--- a/board/bytesatwork/common
+++ /dev/null
@@ -1 +0,0 @@
-../freescale/common
\ No newline at end of file
diff --git a/configs/imx8mp_bytedevkit_defconfig b/configs/imx8mp_bytedevkit_defconfig
index 958d943622..c8836445d1 100644
--- a/configs/imx8mp_bytedevkit_defconfig
+++ b/configs/imx8mp_bytedevkit_defconfig
@@ -26,7 +26,7 @@ CONFIG_SPL_IMX_ROMAPI_LOADADDR=0x48000000
 CONFIG_DEFAULT_DEVICE_TREE="imx8mp-bytedevkit"
 CONFIG_DISTRO_DEFAULTS=y
 CONFIG_SYS_LOAD_ADDR=0x40400000
-CONFIG_BOOTCOMMAND="run sr_ir_v2_cmd;run distro_bootcmd;run bsp_bootcmd"
+CONFIG_BOOTCOMMAND="run bsp_bootcmd"
 CONFIG_FIT=y
 CONFIG_FIT_EXTERNAL_OFFSET=0x3000
 CONFIG_SPL_LOAD_FIT=y
@@ -188,3 +188,4 @@ CONFIG_TEE=y
 CONFIG_EFI_ESRT=y
 CONFIG_EFI_HAVE_CAPSULE_UPDATE=y
 CONFIG_FIT_SIGNATURE=y
+CONFIG_ANDROID_BOOT_IMAGE=n
diff --git a/include/configs/imx8mp_bytedevkit.h b/include/configs/imx8mp_bytedevkit.h
index 3f3f65ca98..12a5cd91a9 100644
--- a/include/configs/imx8mp_bytedevkit.h
+++ b/include/configs/imx8mp_bytedevkit.h
@@ -118,7 +118,7 @@
 	"boot_fdt=try\0" \
 	"fdt_high=0xffffffffffffffff\0"		\
 	"boot_fit=no\0" \
-	"fdtfile=/boot/imx8mp-evk.dtb\0" \
+	"fdtfile=/boot/imx8mp-bytedevkit.dtb\0" \
 	"bootm_size=0x10000000\0" \
 	"mmcdev=1\0" \
 	"mmcpart=1\0" \
@@ -186,11 +186,7 @@
 #define PHYS_SDRAM			0x40000000
 #define PHYS_SDRAM_SIZE			0xC0000000	/* 3 GB */
 #define PHYS_SDRAM_2			0x100000000
-#ifdef CONFIG_TARGET_IMX8MP_DDR4_EVK
 #define PHYS_SDRAM_2_SIZE		0x40000000	/* 1 GB */
-#else
-#define PHYS_SDRAM_2_SIZE		0x40000000	/* 1 GB */
-#endif
 
 #define CONFIG_MXC_UART_BASE		UART1_BASE_ADDR
 
@@ -203,11 +199,7 @@
 
 #define CONFIG_IMX_BOOTAUX
 
-#ifdef CONFIG_TARGET_IMX8MP_DDR4_EVK
-#define CONFIG_SYS_FSL_USDHC_NUM	1
-#else
 #define CONFIG_SYS_FSL_USDHC_NUM	2
-#endif
 #define CONFIG_SYS_FSL_ESDHC_ADDR	0
 
 #ifdef CONFIG_NAND_MXS
@@ -227,8 +219,4 @@
 #define CONFIG_USBD_HS
 #define CONFIG_USB_GADGET_VBUS_DRAW 2
 
-#ifdef CONFIG_ANDROID_SUPPORT
-#include "imx8mp_evk_android.h"
-#endif
-
 #endif
-- 
2.39.2

